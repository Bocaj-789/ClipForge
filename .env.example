# ClipForge configuration. Copy to .env and adjust. Never commit .env.
# All values here are placeholders.

# Where the database, media, clips, logs and model cache live (gitignored).
CLIPFORGE_DATA_DIR=./data

# Bind to loopback only. Do not change to 0.0.0.0; use a secured tunnel for remote access.
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000

# Development mode enables /api/docs and the Vite dev-server CORS origin.
CLIPFORGE_DEV_MODE=false

# Session lifetime in hours.
CLIPFORGE_SESSION_TTL_HOURS=72

# Optional: YouTube Data API key for metadata/discovery (read-only, quota-limited).
# Leave empty to disable. Stored only in .env, never in the database or browser.
CLIPFORGE_YOUTUBE_API_KEY=

# Optional: Ollama endpoint (must stay on loopback).
CLIPFORGE_OLLAMA_URL=http://127.0.0.1:11434
